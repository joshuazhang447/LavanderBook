# Copy to .env and fill in from Supabase -> Project Settings -> API.
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time, so only
# ever put publishable values here. The service_role key must NEVER go in this file.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
