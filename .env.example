# Copy to .env and fill in from Supabase -> Project Settings -> API.
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time, so only
# ever put publishable values here. The service_role key must NEVER go in this file.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# The Google Maps keys. Both of these end up readable by anyone who has the
# app - the web one is in the JS bundle, the Android one is in the APK manifest
# where the Maps SDK reads it - so neither is a secret and both must be
# restricted in the Google Cloud console instead:
#
#   EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY  restrict by HTTP referrer to your web origin
#   GOOGLE_MAPS_ANDROID_KEY          restrict by package name + signing certificate
#
# GOOGLE_MAPS_ANDROID_KEY deliberately has no EXPO_PUBLIC_ prefix: it is read in
# app.config.js at build time and written into the manifest, so the app never
# reads it at runtime and it does not belong in the JS bundle.
#
# .env is not uploaded to EAS. For cloud builds, set GOOGLE_MAPS_ANDROID_KEY as
# an EAS environment variable under the same name.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=<maps-js-api-key>
GOOGLE_MAPS_ANDROID_KEY=<maps-sdk-for-android-key>

# Server-side secrets deliberately do NOT belong in this file. Expo passes only
# EXPO_PUBLIC_* to the app, so anything else here is invisible to it - and
# renaming one to make it visible would compile it into the bundle. They live in
# Supabase instead and are read by the edge functions:
#
#   npx supabase secrets set GOOGLE_PLACES_KEY=...
#
# See supabase/functions/places-search.
#
# There is deliberately no admin credential anywhere in this project. An admin is
# an ordinary Supabase Auth user listed in public.admins, so the password lives
# in auth.users where GoTrue hashes it, and the panel is authorised by Postgres
# rather than by knowing a shared secret. See the migration
# supabase/migrations/20260911061500_admin_roles_and_moderation.sql.
